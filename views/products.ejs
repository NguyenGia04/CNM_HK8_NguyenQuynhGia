<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Sản Phẩm - DynamoDB</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; }
        .card { border: none; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border-radius: 10px; }
        .table thead { background-color: #0d6efd; color: white; }
        .btn-action { margin-right: 5px; }
        /* Style cho cột URL ảnh để nó không bị tràn nếu link quá dài */
        .url-column {
            max-width: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="fas fa-database me-2"></i>DynamoDB Manager</a>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card p-4">
                    <h4 class="mb-3 text-primary"><i class="fas fa-plus-circle me-2"></i>Thêm Sản Phẩm</h4>
                    
                    <form action="/products" method="POST" enctype="multipart/form-data">
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã sản phẩm (ID)</label>
                            <input type="text" name="id" class="form-control" placeholder="VD: 101" required>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên sản phẩm</label>
                            <input type="text" name="name" class="form-control" placeholder="VD: Laptop Dell" required>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá bán</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" name="price" class="form-control" placeholder="VD: 5000000" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn Ảnh Minh Họa</label>
                            <input type="file" name="image" class="form-control" accept="image/*">
                            <small class="text-muted fst-italic">Hệ thống sẽ lưu đường dẫn file sau khi upload.</small>
                        </div>

                        <button type="submit" class="btn btn-success w-100 mt-2">
                            <i class="fas fa-save me-2"></i>Lưu vào Database
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card p-4">
                    <h4 class="mb-3 text-secondary"><i class="fas fa-list me-2"></i>Danh sách hiện có</h4>
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle">
                            <thead class="table-primary">
                                <tr>
                                    <th>ID</th>
                                    <th>Ảnh (URL)</th>
                                    <th>Tên Sản Phẩm</th>
                                    <th>Giá</th>
                                    <th class="text-center" style="width: 120px;">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (products.length > 0) { %>
                                    <% products.forEach(function(item) { %>
                                        <tr>
                                            <td class="fw-bold"><%= item.product_id %></td>
                                            
                                            <td class="url-column" title="<%= item.url_image %>">
                                                <small class="text-muted">
                                                    <%= item.url_image ? item.url_image : 'Chưa có ảnh' %>
                                                </small>
                                            </td>
                                            
                                            <td class="fw-semibold"><%= item.name %></td>
                                            
                                            <td class="text-danger fw-bold">
                                                <%= item.price ? new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.price) : '0 đ' %>
                                            </td>
                                            
                                            <td class="text-center">
                                                <a href="/products/edit/<%= item.product_id %>" class="btn btn-sm btn-warning btn-action" title="Sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                
                                                <a href="/products/delete/<%= item.product_id %>" class="btn btn-sm btn-danger btn-action" 
                                                   onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm <%= item.name %>?');" title="Xóa">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i class="fas fa-box-open fa-3x mb-3"></i><br>
                                            Chưa có dữ liệu nào trong DynamoDB
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>