<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Cập nhật Sản Phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #e9ecef; height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card { width: 100%; max-width: 500px; border-radius: 15px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        .form-control[readonly] { background-color: #e9ecef; color: #6c757d; }
    </style>
</head>
<body>

    <div class="card p-4">
        <div class="text-center mb-4">
            <h3 class="text-primary"><i class="fas fa-edit me-2"></i>Cập nhật thông tin</h3>
            <p class="text-muted">Chỉnh sửa thông tin sản phẩm trong hệ thống</p>
        </div>

        <form action="/products/update" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label fw-bold">Mã sản phẩm</label>
                <input type="text" name="id" class="form-control" value="<%= product.product_id %>" readonly>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tên sản phẩm</label>
                <input type="text" name="name" class="form-control" value="<%= product.name %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Giá bán</label>
                <input type="number" name="price" class="form-control" value="<%= product.price %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Cập nhật ảnh (URL hiện tại)</label>
                <input type="text" class="form-control mb-2" value="<%= product.url_image || 'Chưa có ảnh' %>" disabled>
                
                <input type="hidden" name="current_image" value="<%= product.url_image %>">
                
                <input type="file" name="image" class="form-control">
                <small class="text-muted">Bỏ trống nếu muốn giữ nguyên ảnh cũ</small>
            </div>

            <div class="d-flex justify-content-between">
                <a href="/products" class="btn btn-secondary">Quay lại</a>
                <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
            </div>
        </form>
    </div>

</body>
</html>