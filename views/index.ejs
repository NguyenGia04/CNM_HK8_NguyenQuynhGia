<%- include('partials/header') %>

    <div class="row mb-5 align-items-end">
        <div class="col-md-7">
            <h5 class="text-secondary text-uppercase ls-2 mb-1">Showroom Online 123</h5>
            <h2 class="fw-bold display-6 text-white">Danh sách xe hiện có</h2>
        </div>
        <div class="col-md-5">
            <form action="/" method="GET" class="d-flex shadow-sm rounded-pill overflow-hidden border border-secondary border-opacity-25">
                <input class="form-control border-0 py-2 ps-4 search-input" type="search" name="search" value="<%= searchQuery || '' %>" placeholder="Tìm kiếm mẫu xe..." style="border-radius: 0;">
                <button class="btn btn-primary px-4 fw-bold" type="submit" style="border-radius: 0;">TÌM</button>
            </form>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% if (products.length > 0) { %>
            <% products.forEach(product => { %>
                <div class="col">
                    <div class="card h-100">
                        <div class="product-img-wrapper">
                            <img src="<%= product.image %>" class="product-img" alt="<%= product.name %>">
                            <div class="price-tag">
                                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title">
                                    <%= product.name %>
                                </h5>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <small class="text-secondary"><i class="fas fa-fingerprint me-1"></i>ID: <%= product.id %></small>
                                <% if(product.quantity > 0) { %>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                    Sẵn hàng: <%= product.quantity %>
                                </span>
                                    <% } else { %>
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Hết hàng</span>
                                        <% } %>
                            </div>

                            <div class="d-flex gap-2 pt-3 border-top border-secondary border-opacity-10">
                                <a href="/edit/<%= product.id %>" class="btn btn-action btn-edit flex-grow-1 text-center text-decoration-none">
                                    <i class="fas fa-pen me-1"></i> Chỉnh sửa
                                </a>
                                <form action="/delete/<%= product.id %>" method="POST" class="d-inline" onsubmit="return confirm('Xóa mẫu xe này khỏi hệ thống?');">
                                    <button type="submit" class="btn btn-action btn-delete w-100">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
                    <% } else { %>
                        <div class="col-12 text-center py-5">
                            <div class="text-secondary opacity-50 mb-3">
                                <i class="fas fa-car fa-4x"></i>
                            </div>
                            <h4 class="text-white">Không tìm thấy sản phẩm nào</h4>
                            <p class="text-secondary">Thử tìm kiếm từ khóa khác hoặc thêm xe mới.</p>
                            <a href="/add" class="btn btn-primary btn-lg mt-2 rounded-pill px-5">Thêm xe ngay</a>
                        </div>
                        <% } %>
    </div>

    <% if (totalPages > 1) { %>
        <nav class="mt-5">
            <ul class="pagination justify-content-center custom-pagination">

                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="/?page=<%= currentPage - 1 %><%= searchQuery ? '&search=' + searchQuery : '' %>">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>

                <% for(let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link" href="/?page=<%= i %><%= searchQuery ? '&search=' + searchQuery : '' %>">
                            <%= i %>
                        </a>
                    </li>
                    <% } %>

                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="/?page=<%= currentPage + 1 %><%= searchQuery ? '&search=' + searchQuery : '' %>">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
            </ul>
        </nav>
        <% } %>

            </div>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            </body>

            </html>